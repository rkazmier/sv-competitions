---
/**
 * Jeden dzień harmonogramu na stronie zawodów (AC-38): tabela „Godzina, Opis” z dniem w podpisie.
 * Bez `day` renderuje pusty wzór dla podglądu w panelu (lib/competition-view-ui.ts wypełnia go `textContent`).
 */
import { t } from '../i18n';
import type { ScheduleDay } from '../lib/competition-page';

interface Props {
  day?: ScheduleDay;
}

const { day } = Astro.props;
---
<table class="schedule-day" data-schedule-day>
  <caption data-day-heading>{day?.heading}</caption>
  <thead>
    <tr>
      <th scope="col">{t('schedule.time')}</th>
      <th scope="col">{t('schedule.description')}</th>
    </tr>
  </thead>
  <tbody data-day-items>
    {day?.items.map((item) => (
      <tr>
        <td>{item.time}</td>
        <td>{item.description}</td>
      </tr>
    ))}
  </tbody>
</table>

<style is:global>
  /* Globalne z prefiksem klasy: w podglądzie panelu wiersze powstają w przeglądarce, bez atrybutów zakresu Astro. */
  .schedule-day {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-surface);
  }

  .schedule-day caption {
    padding-bottom: var(--space-2);
    text-align: left;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-strong);
  }

  .schedule-day th,
  .schedule-day td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: var(--border-width) solid var(--color-border);
    overflow-wrap: anywhere;
  }

  .schedule-day th {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .schedule-day th:first-child,
  .schedule-day td:first-child {
    width: 6rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
</style>
