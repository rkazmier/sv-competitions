---
/**
 * Klauzula informacyjna RODO (SPEC-002 AC-2, AC-3, §9). Tekst zastępczy do czasu dostarczenia treści
 * przez właściciela (#39) — wtedy podmień `privacy.placeholder` w i18n.
 */
import { t } from '../i18n';

interface Props {
  headingId: string;
}

const { headingId } = Astro.props;
---
<h2 id={headingId}>{t('privacy.title')}</h2>
<p>{t('privacy.placeholder')}</p>
