---
/**
 * Strona zawodów (SPEC-001 AC-38, AC-39): nazwa, termin, dyscyplina, regulamin i matchbook (PDF), opis, harmonogram.
 * Wspólny komponent strony statycznej `/zawody/<slug>/` (z `view`) i podglądu w panelu (AC-24, bez `view`):
 * podgląd wypełnia te same elementy w przeglądarce (lib/competition-view-ui.ts), tylko przez `textContent`.
 */
import { t } from '../i18n';
import type { CompetitionView } from '../lib/competition-page';
import ScheduleDayTable from './ScheduleDayTable.astro';

interface Props {
  view?: CompetitionView;
}

const { view } = Astro.props;
---
<article class="competition-page" data-competition-page hidden={!view}>
  <header class="competition-header">
    <p class="competition-kind">{t('competitionPage.kind')}</p>
    <h1 data-name>{view?.name}</h1>
    <dl class="competition-facts">
      <div>
        <dt>{t('competitionPage.dateLabel')}</dt>
        <dd data-date>{view?.dateRange}</dd>
      </div>
      <div>
        <dt>{t('competitionPage.disciplineLabel')}</dt>
        <dd data-discipline>{view?.discipline}</dd>
      </div>
    </dl>
    <div class="button-row competition-documents">
      <a class="button button-primary" data-rulebook href={view?.rulebookUrl ?? undefined} hidden={!view?.rulebookUrl}>{t('competitionPage.rulebook')}</a>
      <p class="soon" data-rulebook-soon hidden={!view || Boolean(view.rulebookUrl)}>{t('competitionPage.rulebookSoon')}</p>
      <a class="button" data-matchbook href={view?.matchbookUrl ?? undefined} hidden={!view?.matchbookUrl}>{t('competitionPage.matchbook')}</a>
      <p class="soon" data-matchbook-soon hidden={!view || Boolean(view.matchbookUrl)}>{t('competitionPage.matchbookSoon')}</p>
    </div>
  </header>

  <div class="competition-description" data-description>
    {view?.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <section class="competition-schedule" aria-labelledby="schedule-heading">
    <h2 id="schedule-heading">{t('schedule.heading')}</h2>
    <p class="soon" data-schedule-soon hidden={!view || view.schedule.length > 0}>{t('competitionPage.scheduleSoon')}</p>
    <div class="competition-schedule-days" data-schedule-days>
      {view?.schedule.map((day) => <ScheduleDayTable day={day} />)}
    </div>
  </section>

  <template data-schedule-day-template>
    <ScheduleDayTable />
  </template>
</article>

<style is:global>
  /* Globalne z prefiksem klasy: w podglądzie panelu akapity powstają w przeglądarce, bez atrybutów zakresu Astro. */
  .competition-page {
    display: grid;
    gap: var(--space-6);
    overflow-wrap: anywhere;
  }

  .competition-page h1,
  .competition-page h2,
  .competition-page p {
    margin: 0;
  }

  .competition-header {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-4);
    border-left: 6px solid var(--color-highlight);
  }

  .competition-kind {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .competition-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }

  .competition-facts dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .competition-facts dd {
    margin: 0;
    font-weight: var(--font-weight-strong);
  }

  .competition-documents {
    align-items: center;
  }

  .competition-page .soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .competition-documents .soon {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2);
  }

  .competition-description {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-narrow);
  }

  .competition-description p {
    white-space: pre-line;
  }

  .competition-schedule,
  .competition-schedule-days {
    display: grid;
    gap: var(--space-5);
  }
</style>
