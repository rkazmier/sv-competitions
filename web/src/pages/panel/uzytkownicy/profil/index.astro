---
/**
 * Panel: karta użytkownika `/panel/uzytkownicy/profil/?id=` (SPEC-002 AC-17, AC-18, AC-20, AC-21, AC-23…AC-25, §6).
 * Tylko admin. Dane (te same pola i walidacja co `/konto/dane/`), rola (`rpc/set_user_role`), „Historia zmian” (`audit_log`),
 * „Usuń konto” (Edge Function `admin-delete-user`), „Rozpocznij wpis do książki” (SPEC-005 AC-8),
 * „Karnety i zużycie” z „Cofnij zużycie” (SPEC-005 AC-23).
 * Dane obsługuje lib/admin-users-ui.ts po potwierdzeniu roli admina.
 */
import PanelLayout from '../../../../layouts/PanelLayout.astro';
import ProfileFields from '../../../../components/ProfileFields.astro';
import { t } from '../../../../i18n';
import { ROLES } from '../../../../lib/admin-users';
---
<PanelLayout title={t('users.cardTitle')}>
  <div class="users stack" data-user-card>
    <p><a href="/panel/uzytkownicy/">{t('users.backToList')}</a></p>
    <h1 data-title>{t('users.cardTitle')}</h1>
    <p role="status" data-loading>{t('panel.loading')}</p>
    <p class="message-error" role="alert" data-not-found hidden>{t('users.notFound')}</p>
    <p role="status" data-deleted hidden>{t('users.deleted')}</p>

    <div class="stack" data-content hidden>
      <p class="tag" data-ready hidden>{t('account.ready')}</p>
      <p><a class="button button-primary" data-start-entry>{t('users.startEntry')}</a></p>

      <form class="card auth-form" data-profile novalidate>
        <h2>{t('users.dataTitle')}</h2>
        <p class="hint">{t('profile.intro')}</p>
        <ProfileFields />
        <p class="message-error" role="alert" data-form-error hidden></p>
        <p role="status" data-form-status></p>
        <div class="button-row">
          <button type="submit" class="button button-primary" data-submit>{t('profile.save')}</button>
        </div>
      </form>

      <form class="card auth-form" data-role-form>
        <h2>{t('users.roleTitle')}</h2>
        <label class="field-label" for="u-role">{t('users.role')}</label>
        <select class="input" id="u-role" name="role">
          {ROLES.map((role) => <option value={role}>{t(`users.roles.${role}`)}</option>)}
        </select>
        <p class="message-error" role="alert" data-role-error hidden></p>
        <p role="status" data-role-status></p>
        <div class="button-row">
          <button type="submit" class="button button-primary" data-role-submit>{t('users.changeRole')}</button>
        </div>
      </form>

      <section class="card stack" aria-labelledby="u-passes" data-pass-usages>
        <h2 id="u-passes">{t('rangeHistory.passesTitle')}</h2>
        <p data-pass-empty hidden>{t('rangeHistory.passesEmpty')}</p>
        <p class="message-error" role="alert" data-revert-error hidden></p>
        <p role="status" data-revert-status></p>
        <ul class="users-passes" data-pass-list></ul>
      </section>

      <section class="card stack" aria-labelledby="u-history">
        <h2 id="u-history">{t('users.historyTitle')}</h2>
        <p data-history-empty hidden>{t('users.historyEmpty')}</p>
        <ol class="users-history" data-history></ol>
      </section>

      <section class="card stack" aria-labelledby="u-delete" data-delete>
        <h2 id="u-delete">{t('users.deleteTitle')}</h2>
        <div class="button-row">
          <button type="button" class="button" data-delete-open aria-describedby="u-delete-own">
            {t('users.deleteButton')}
          </button>
        </div>
        <p class="hint" id="u-delete-own" data-delete-own hidden>{t('users.deleteOwn')}</p>
        <form class="auth-form stack" data-delete-form hidden>
          <p class="message-error" data-delete-warning>{t('users.deleteWarning')}</p>
          <label class="field-label" for="u-delete-confirm">{t('users.deleteConfirmLabel')}</label>
          <input class="input" id="u-delete-confirm" name="confirm" autocomplete="off" autocapitalize="characters" spellcheck="false" />
          <p class="message-error" role="alert" data-delete-error hidden></p>
          <div class="button-row">
            <button type="submit" class="button button-primary" data-delete-submit disabled>{t('users.deleteConfirm')}</button>
            <button type="button" class="button" data-delete-cancel>{t('users.deleteCancel')}</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</PanelLayout>

<script>
  import { mountUserCard } from '../../../../lib/admin-users-ui';

  void mountUserCard(document.querySelector<HTMLElement>('[data-user-card]')!);
</script>
