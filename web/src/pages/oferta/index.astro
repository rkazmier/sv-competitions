---
/**
 * Oferta (SPEC-003 AC-5, AC-6): grupy produktów z ceną, opisem i informacjami o ważności.
 * Produkty pobierane w przeglądarce (ceny zawsze aktualne, bez `site-rebuild`) — lib/offer-ui.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { PRODUCT_KINDS } from '../../lib/products';
---
<BaseLayout title={t('offer.title')}>
  <section class="section">
    <div class="container offer-layout">
      <div class="offer" data-offer>
        <h1>{t('offer.title')}</h1>
        <p>{t('offer.intro')}</p>
        <p role="status" data-loading>{t('offer.loading')}</p>
        <p class="message-error" role="alert" data-load-error hidden>{t('offer.loadError')}</p>
        <div class="offer-groups" data-groups hidden>
          {
            PRODUCT_KINDS.map((kind) => (
              <section aria-labelledby={`offer-${kind}`}>
                <h2 id={`offer-${kind}`}>{t(`products.groups.${kind}`)}</h2>
                <p class="hint" data-empty={kind}>{t('offer.empty')}</p>
                <ul class="offer-list" data-group={kind}></ul>
              </section>
            ))
          }
        </div>
      </div>
      <!-- SPEC-012 AC-37, AC-38: godziny otwarcia i dni blokady — pobierane w przeglądarce (lib/opening-hours-ui.ts). -->
      <section class="opening-hours-public" id="godziny" aria-labelledby="godziny-heading" data-opening-hours>
        <h2 id="godziny-heading">{t('openingHours.title')}</h2>
        <p role="status" data-hours-loading>{t('openingHours.loading')}</p>
        <p class="message-error" role="alert" data-hours-error hidden>{t('openingHours.loadError')}</p>
        <p data-hours-soon hidden>{t('openingHours.soon')}</p>
        <dl class="hours-week" data-week hidden></dl>
        <div data-exceptions-section hidden>
          <h3>{t('openingHours.exceptionsHeading')}</h3>
          <ul data-exceptions></ul>
        </div>
        <div data-blocked-section hidden>
          <h3>{t('openingHours.blockedHeading')}</h3>
          <p class="hint" data-blocked-empty>{t('openingHours.blockedEmpty')}</p>
          <ul data-blocked></ul>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .offer,
  .offer-groups {
    display: grid;
    gap: var(--space-4);
  }

  /* Wąskie ekrany: godziny otwarcia pod ofertą; szerokie: panel z prawej (przyklejony przy przewijaniu). */
  .offer-layout {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 64rem) {
    .offer-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-6);
      align-items: start;
    }

    .opening-hours-public {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
      padding: var(--space-4);
      background: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius-lg);
      max-height: calc(100vh - var(--header-height) - 2 * var(--space-4));
      overflow-y: auto;
    }

    .opening-hours-public h2 {
      font-size: var(--text-h3);
    }

    .opening-hours-public h3 {
      font-size: var(--text-lg);
    }
  }

  .offer > *,
  .offer-groups h2 {
    margin: 0;
  }

  .offer-list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .offer-list {
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    }
  }

  .offer-item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .offer-item > * {
    margin: 0;
  }

  .offer-item .button {
    justify-self: start;
  }

  .offer-price {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-strong);
  }

  .opening-hours-public,
  .opening-hours-public > div {
    display: grid;
    gap: var(--space-2);
    scroll-margin-top: var(--space-6);
  }

  .opening-hours-public h2,
  .opening-hours-public h3,
  .opening-hours-public p,
  .opening-hours-public ul {
    margin: 0;
  }

  .hours-week {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-4);
    margin: 0;
  }

  .hours-week dd {
    margin: 0;
  }

  .offer .hint,
  .offer-item .hint,
  .opening-hours-public .hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { mountOffer } from '../../lib/offer-ui';

  import { mountOpeningHours } from '../../lib/opening-hours-ui';

  const root = document.querySelector<HTMLElement>('[data-offer]');
  if (root) void mountOffer(root);
  const hours = document.querySelector<HTMLElement>('[data-opening-hours]');
  if (hours) void mountOpeningHours(hours);
</script>
