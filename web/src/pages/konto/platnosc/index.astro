---
/**
 * Powrót z bramki Tpay (SPEC-003 AC-10): stan zamówienia `?order=` odświeżany co 3 s przez maks. 60 s.
 * Status ustawia wyłącznie `payments-notify` — strona tylko odczytuje `orders` (RLS: własne).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { ACCOUNT_HOME } from '../../../lib/auth';
---
<BaseLayout title={t('offer.paymentTitle')} indexable={false}>
  <section class="section">
    <div class="container auth payment" data-payment>
      <h1>{t('offer.paymentTitle')}</h1>
      <p role="status" aria-live="polite" data-payment-status>{t('panel.loading')}</p>
      <a class="button button-primary" href={ACCOUNT_HOME} data-account-link hidden>{t('offer.goToAccount')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .payment {
    display: grid;
    gap: var(--space-3);
  }

  .payment > * {
    margin: 0;
    justify-self: start;
  }
</style>

<script>
  import { mountPaymentStatus } from '../../../lib/offer-ui';

  const root = document.querySelector<HTMLElement>('[data-payment]');
  if (root) void mountPaymentStatus(root);
</script>
