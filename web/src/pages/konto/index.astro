---
/**
 * Konto użytkownika (SPEC-002 §6) — cel po zalogowaniu i po linku potwierdzającym e-mail (AC-1, AC-3, AC-5).
 * Klauzula przy pierwszym logowaniu (Google), potem: braki lub gotowość do wpisu (AC-9, AC-10), kod QR (AC-12…AC-15),
 * „Twoje dane” + „Edytuj dane” (AC-7). Karnety, historia karnetów i płatności, „Przedłuż karnet” — SPEC-003 AC-12…AC-15
 * (lib/offer-ui.ts). „Historia wejść” i historia zużycia karnetu — SPEC-005 AC-24, AC-25. Kod QR zaraz po statusie — na telefonie obsługa skanuje z ekranu.
 * Logika: lib/auth-ui.ts (sesja, klauzula), lib/account-ui.ts (panel).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyNotice from '../../components/PrivacyNotice.astro';
import { t } from '../../i18n';
import { OFFER_PAGE } from '../../lib/offer';

const fields = [
  ['full_name', t('profile.fullName')],
  ['email', t('profile.email')],
  ['phone', t('profile.phone')],
  ['permit_number', t('profile.permitNumber')],
  ['permit_authority', t('profile.permitAuthority')],
  ['address', t('profile.address')],
] as const;
---
<BaseLayout title={t('account.title')} indexable={false}>
  <section class="section">
    <div class="container auth account-page">
      <p role="status" data-account-state="loading">{t('panel.loading')}</p>
      <div class="card" data-account-state="ack" hidden>
        <p>{t('privacy.ackIntro')}</p>
        <PrivacyNotice headingId="ack-heading" />
        <p class="message-error" role="alert" data-form-error hidden></p>
        <button type="button" class="button button-primary" data-ack>{t('privacy.ack')}</button>
      </div>
      <div class="account" data-account-state="ready" hidden>
        <h1>{t('account.title')}</h1>

        <div class="card account-missing" data-missing hidden>
          <h2>{t('account.missingTitle')}</h2>
          <ul></ul>
          <a class="button button-primary" href="/konto/dane/">{t('account.completeData')}</a>
        </div>
        <p class="account-ready" data-ready hidden>{t('account.ready')}</p>

        <section class="card account-qr" aria-labelledby="qr-heading">
          <h2 id="qr-heading">{t('account.qrTitle')}</h2>
          <p class="hint">{t('account.qrIntro')}</p>
          <div class="qr" data-qr></div>
          <div class="button-row">
            <button type="button" class="button" data-qr-fullscreen>{t('account.qrFullscreen')}</button>
            <button type="button" class="button" data-qr-print>{t('account.qrPrint')}</button>
            <button type="button" class="button" data-qr-rotate>{t('account.qrRotate')}</button>
          </div>
          <p role="status" data-qr-status></p>
        </section>

        <div class="account-passes" data-passes-root>
          <section class="card" aria-labelledby="passes-heading">
            <h2 id="passes-heading">{t('offer.passesTitle')}</h2>
            <p class="hint" data-passes-empty hidden>{t('offer.passesEmpty')}</p>
            <ul class="pass-list" data-passes></ul>
            <a class="button button-primary" href={OFFER_PAGE}>{t('offer.renew')}</a>
            <details class="pass-history">
              <summary>{t('offer.passHistoryTitle')}</summary>
              <p class="hint" data-pass-history-empty hidden>{t('offer.passHistoryEmpty')}</p>
              <ul class="pass-list" data-pass-history></ul>
            </details>
          </section>

          <section class="card account-wide" aria-labelledby="payments-heading">
            <h2 id="payments-heading">{t('offer.paymentsTitle')}</h2>
            <p class="hint" data-orders-empty hidden>{t('offer.paymentsEmpty')}</p>
            <div class="table-scroll" data-orders-table hidden>
              <table class="orders-table">
                <thead>
                  <tr>
                    <th scope="col">{t('offer.orderDate')}</th>
                    <th scope="col">{t('offer.orderItem')}</th>
                    <th scope="col">{t('offer.orderAmount')}</th>
                    <th scope="col">{t('offer.orderMethod')}</th>
                    <th scope="col">{t('offer.orderStatus')}</th>
                  </tr>
                </thead>
                <tbody data-orders></tbody>
              </table>
            </div>
          </section>
          <section class="card" aria-labelledby="entries-heading">
            <h2 id="entries-heading">{t('rangeHistory.entriesTitle')}</h2>
            <p class="hint" data-entries-empty hidden>{t('rangeHistory.entriesEmpty')}</p>
            <div class="table-scroll" data-entries-table hidden>
              <table class="orders-table">
                <thead>
                  <tr>
                    <th scope="col">{t('rangeHistory.entryDate')}</th>
                    <th scope="col">{t('rangeHistory.entryOfficer')}</th>
                    <th scope="col">{t('rangeHistory.entryPass')}</th>
                  </tr>
                </thead>
                <tbody data-entries></tbody>
              </table>
            </div>
          </section>
          <p class="message-error account-full" role="alert" data-passes-error hidden>{t('offer.passesLoadError')}</p>
        </div>

        <section class="card" aria-labelledby="data-heading">
          <h2 id="data-heading">{t('account.dataTitle')}</h2>
          <dl class="account-data">
            {fields.map(([name, label]) => (
              <div>
                <dt>{label}</dt>
                <dd data-field={name}></dd>
              </div>
            ))}
          </dl>
          <a class="button" href="/konto/dane/">{t('account.editData')}</a>
        </section>

        <div class="account-full account-signout">
          <p data-signed-in-as></p>
          <button type="button" class="button" data-sign-out>{t('account.signOut')}</button>
        </div>
      </div>
      <p class="message-error" role="alert" data-account-state="error" hidden>{t('account.loadError')}</p>
    </div>
  </section>

  <dialog class="qr-fullscreen" data-qr-dialog aria-label={t('account.qrLabel')}>
    <div class="qr" data-qr></div>
    <button type="button" class="button button-primary" data-close>{t('account.close')}</button>
  </dialog>

  <!-- AC-14: tylko do druku — kod (min. 4 cm) i imię i nazwisko, bez menu i stopki -->
  <div class="qr-print" aria-hidden="true">
    <div class="qr" data-qr></div>
    <p data-print-name></p>
  </div>
</BaseLayout>

<style is:global>
  .account,
  .account .card {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .account > *,
  .account .card > * {
    margin: 0;
  }

  .account .card > .button {
    justify-self: start;
  }

  .account-passes {
    display: grid;
    gap: var(--space-3);
  }

  .pass-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pass-item {
    display: grid;
    gap: var(--space-1);
  }

  .pass-item > * {
    margin: 0;
  }

  .pass-item h3 {
    font-size: var(--text-base);
  }

  .pass-history summary {
    min-height: var(--tap-target);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: var(--font-weight-strong);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .orders-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .orders-table th,
  .orders-table td {
    padding: var(--space-2);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .orders-table .order-ref,
  .orders-table .invoice-status {
    display: block;
    color: var(--color-text-muted);
  }

  .account-signout {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .account-signout > * {
    margin: 0;
  }

  /*
   * Szerokie ekrany: panel na całą szerokość kontenera, karty jako kafelki.
   * „Historia płatności” zajmuje dwie kolumny. Na telefonie bez zmian — jedna kolumna, kod QR zaraz po statusie.
   */
  @media (min-width: 48rem) {
    .container.account-page {
      max-width: calc(var(--container-max) + 2 * var(--container-pad));
      justify-items: stretch;
    }

    .account-page > [data-account-state='ack'],
    .account-page > [data-account-state='loading'],
    .account-page > [data-account-state='error'] {
      max-width: 30rem;
    }

    .account {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
      grid-auto-flow: row dense;
      align-items: stretch;
      gap: var(--space-4);
    }

    .account > h1,
    .account > .account-missing,
    .account > .account-ready,
    .account .account-full {
      grid-column: 1 / -1;
    }

    .account-passes {
      display: contents;
    }

    .account .card {
      align-content: start;
      /* elementy siatki mają min-width: auto — bez tego tabele nowrap rozpychają kolumny zamiast przewijać się w .table-scroll */
      min-width: 0;
    }

    .account .account-wide {
      grid-column: span 2;
    }
  }

  .account-missing {
    border-color: var(--color-danger);
  }

  .account-missing ul {
    padding-left: var(--space-5);
  }

  .account-ready {
    font-weight: var(--font-weight-strong);
  }

  .account-ready::before {
    content: '✓ ';
  }

  .account .hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .qr svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .account-qr .qr {
    width: min(18rem, 100%);
  }

  .account-data {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .account-data dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .account-data dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* AC-13: kod na cały ekran, czarny na białym */
  .qr-fullscreen {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-4);
    border: 0;
    background: #fff;
  }

  .qr-fullscreen[open] {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-4);
  }

  .qr-fullscreen::backdrop {
    background: #fff;
  }

  .qr-fullscreen .qr {
    width: min(90vw, calc(100dvh - 8rem));
  }

  .qr-print {
    display: none;
  }

  @media print {
    body > :not(main),
    main > :not(.qr-print) {
      display: none !important;
    }

    .qr-print {
      display: block;
      text-align: center;
    }

    .qr-print .qr {
      width: 6cm;
      margin: 0 auto;
    }

    .qr-print p {
      margin-top: 0.5cm;
      font-size: 14pt;
      font-weight: bold;
    }
  }
</style>

<script>
  import { mountAccount } from '../../lib/auth-ui';

  void mountAccount();
</script>
