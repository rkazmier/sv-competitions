---
/**
 * Formularz danych użytkownika (SPEC-002 AC-7, AC-8, AC-11, §6): Imię i nazwisko*, Telefon, Numer decyzji,
 * Organ wydający, Adres zamieszkania; e-mail tylko do odczytu. Logika: lib/account-ui.ts, walidacja: lib/profile.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProfileFields from '../../../components/ProfileFields.astro';
import { t } from '../../../i18n';
---
<BaseLayout title={t('profile.title')} indexable={false}>
  <section class="section">
    <div class="container auth">
      <h1>{t('profile.title')}</h1>
      <p role="status" data-loading>{t('panel.loading')}</p>
      <p class="message-error" role="alert" data-load-error hidden>{t('account.loadError')}</p>

      <form class="card auth-form" data-profile novalidate hidden>
        <p class="hint">{t('profile.intro')}</p>
        <ProfileFields emailHint={t('profile.emailHint')} />

        <p class="message-error" role="alert" data-form-error hidden></p>
        <div class="button-row">
          <button type="submit" class="button button-primary" data-submit>{t('profile.save')}</button>
          <a class="button" href="/konto/">{t('profile.cancel')}</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountProfileForm } from '../../../lib/account-ui';

  void mountProfileForm();
</script>
