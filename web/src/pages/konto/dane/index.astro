---
/**
 * Formularz danych użytkownika (SPEC-002 AC-7, AC-8, AC-11, §6): Imię i nazwisko*, Telefon, Numer decyzji,
 * Organ wydający, Adres zamieszkania; e-mail tylko do odczytu. Logika: lib/account-ui.ts, walidacja: lib/profile.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';

interface Field {
  name: string;
  label: string;
  required?: boolean;
  type?: 'text' | 'tel';
  autocomplete?: 'name' | 'tel' | 'street-address';
  hint?: string;
}

const fields: Field[] = [
  { name: 'full_name', label: t('profile.fullName'), required: true, autocomplete: 'name' },
  { name: 'phone', label: t('profile.phone'), type: 'tel', autocomplete: 'tel', hint: t('profile.phoneHint') },
  { name: 'permit_number', label: t('profile.permitNumber'), hint: t('profile.permitHint') },
  { name: 'permit_authority', label: t('profile.permitAuthority') },
  { name: 'address', label: t('profile.address'), autocomplete: 'street-address', hint: t('profile.addressHint') },
];
---
<BaseLayout title={t('profile.title')} indexable={false}>
  <section class="section">
    <div class="container auth">
      <h1>{t('profile.title')}</h1>
      <p role="status" data-loading>{t('panel.loading')}</p>
      <p class="message-error" role="alert" data-load-error hidden>{t('account.loadError')}</p>

      <form class="card auth-form" data-profile novalidate hidden>
        <p class="hint">{t('profile.intro')}</p>
        {fields.map((field) => (
          <div class="auth-form">
            <label class="field-label" for={`f-${field.name}`}>
              {field.label}{field.required && <span aria-hidden="true"> *</span>}
              {field.required && <span class="visually-hidden">{t('profile.required')}</span>}
            </label>
            {field.hint && <p class="hint" id={`f-${field.name}-hint`}>{field.hint}</p>}
            <input
              class="input"
              id={`f-${field.name}`}
              name={field.name}
              type={field.type ?? 'text'}
              autocomplete={field.autocomplete ?? 'off'}
              required={field.required}
              aria-describedby={[field.hint && `f-${field.name}-hint`, `f-${field.name}-error`].filter(Boolean).join(' ')}
            />
            <p class="message-error" id={`f-${field.name}-error`} data-error-for={field.name} hidden></p>
          </div>
        ))}
        <label class="field-label" for="f-email">{t('profile.email')}</label>
        <p class="hint" id="f-email-hint">{t('profile.emailHint')}</p>
        <input class="input" id="f-email" name="email" type="email" readonly aria-describedby="f-email-hint" />

        <p class="message-error" role="alert" data-form-error hidden></p>
        <div class="button-row">
          <button type="submit" class="button button-primary" data-submit>{t('profile.save')}</button>
          <a class="button" href="/konto/">{t('profile.cancel')}</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountProfileForm } from '../../../lib/account-ui';

  void mountProfileForm();
</script>
