---
/**
 * Układ panelu: ten sam co strony publiczne, z menu panelu zamiast
 * nawigacji publicznej i `noindex` (SPEC-001 §6.1, §6.2).
 * Bramka logowania (lib/panel.ts, ADR-0004): treść strony (slot) i pełne menu widzi tylko admin;
 * obsługa — własne menu (książka, sprzedaż, prowadzący — SPEC-007 AC-10, dyżury — AC-22), bez kalendarza i słowników (SPEC-002 AC-26); użytkownik — brak uprawnień
 * i link do konta (AC-27); niezalogowany — logowanie Google (SPEC-001 AC-4).
 * Skrypt strony pobiera dane po `await requireAdmin()`; strony z `access="staff"` (książka — SPEC-005,
 * sprzedaż — SPEC-003 US-5) pokazują treść także obsłudze i pobierają dane po `await requireStaff()`.
 * `access="duty"` (książka — SPEC-008) — także dyżurnemu Prowadzącemu z konta (menu tylko „Książka”, `requireRangeLog()`).
 * `forbiddenNote` — dopisek pod „Nie masz uprawnień do panelu.” (SPEC-008 AC-3).
 */
import BaseLayout from './BaseLayout.astro';
import { t } from '../i18n';

interface Props {
  title?: string;
  /** Kto widzi treść strony: tylko admin (domyślnie) albo także obsługa strzelnicy. */
  access?: 'admin' | 'staff' | 'duty';
  forbiddenNote?: string;
}

const { title, access = 'admin', forbiddenNote } = Astro.props;
const contentStates = { admin: 'admin', staff: 'admin staff', duty: 'admin staff duty' }[access];
const salesItem = { href: '/panel/sprzedaz/', label: t('panel.menu.sales') };
const rangeLogItem = { href: '/panel/ksiazka/', label: t('panel.menu.rangeLog') };
// SPEC-007 AC-7: „Prowadzący (n)” — liczba zgłoszeń z kont do zatwierdzenia; także w menu obsługi (AC-10).
const officersItem = { href: '/panel/prowadzacy/', label: t('panel.menu.rangeOfficers'), officerCount: true };
// SPEC-007 AC-22: grafik dyżurów — Obsługa i admin.
const dutyScheduleItem = { href: '/panel/dyzury/', label: t('panel.menu.rangeDutySchedule') };
const adminMenu = [
  { href: '/panel/', label: t('panel.menu.calendar') },
  { href: '/panel/regulaminy/', label: t('panel.menu.rulebooks') },
  { href: '/panel/dyscypliny/', label: t('panel.menu.disciplines') },
  { href: '/panel/kategorie/', label: t('panel.menu.categories') },
  { href: '/panel/oferta/', label: t('panel.menu.offer') },
  salesItem,
  { href: '/panel/zamowienia/', label: t('panel.menu.orders') },
  { href: '/panel/faktury/', label: t('panel.menu.invoices'), invoiceCount: true },
  { href: '/panel/uzytkownicy/', label: t('panel.menu.users') },
  rangeLogItem,
  { href: '/panel/ksiazka/przeglad/', label: t('panel.menu.rangeReview') },
  officersItem,
  dutyScheduleItem,
  { href: '/panel/zamkniecia/', label: t('panel.menu.rangeClosures') },
];
const staffMenu = [rangeLogItem, salesItem, officersItem, dutyScheduleItem];
const isCurrent = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
---
<BaseLayout title={title} indexable={false} navLabel={t('layout.panelMenuLabel')}>
  <Fragment slot="nav">
    <ul data-panel-menu="admin" hidden>
      {
        adminMenu.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href)}>
              {item.label}
              {'invoiceCount' in item && <span class="menu-count" data-invoice-count hidden />}
              {'officerCount' in item && <span class="menu-count" data-officer-count hidden />}
            </a>
          </li>
        ))
      }
      <li><button type="button" class="nav-button" data-sign-out>{t('panel.signOut')}</button></li>
    </ul>
    <ul data-panel-menu="staff" hidden>
      {
        staffMenu.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href)}>
              {item.label}
              {'officerCount' in item && <span class="menu-count" data-officer-count hidden />}
            </a>
          </li>
        ))
      }
      <li><button type="button" class="nav-button" data-sign-out>{t('panel.signOut')}</button></li>
    </ul>
    <!-- SPEC-008 AC-2: dyżurny Prowadzący z konta — tylko „Książka”. -->
    <ul data-panel-menu="duty" hidden>
      <li><a href={rangeLogItem.href} aria-current={isCurrent(rangeLogItem.href)}>{rangeLogItem.label}</a></li>
      <li><button type="button" class="nav-button" data-sign-out>{t('panel.signOut')}</button></li>
    </ul>
  </Fragment>
  <section class="section panel">
    <div class="container">
      <div data-panel-state="loading">
        <p role="status">{t('panel.loading')}</p>
      </div>
      <div data-panel-state="signedOut" hidden>
        <h1>{t('panel.title')}</h1>
        <p>{t('panel.signInIntro')}</p>
        <button type="button" class="button button-primary" data-sign-in>{t('panel.signIn')}</button>
      </div>
      <div data-panel-state="forbidden" hidden>
        <h1>{t('panel.title')}</h1>
        <p>{t('panel.forbidden')}</p>
        {forbiddenNote && <p data-forbidden-note>{forbiddenNote}</p>}
        <div class="button-row">
          <a class="button button-primary" href="/konto/">{t('panel.goToAccount')}</a>
          <button type="button" class="button" data-sign-out>{t('panel.signOut')}</button>
        </div>
      </div>
      {
        access === 'admin' && (
          <div data-panel-state="staff" hidden>
            <h1>{t('panel.title')}</h1>
            <p>{t('panel.staffComingSoon')}</p>
          </div>
        )
      }
      <div data-panel-state="error" hidden>
        <h1>{t('panel.title')}</h1>
        <p class="message-error" role="alert">{t('panel.loadError')}</p>
      </div>
      <div data-panel-state={contentStates} hidden>
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { t } from '../i18n';
  import { requireAdmin, requireStaff } from '../lib/panel';
  import { PENDING_COUNT_EVENT, pendingMenuLabel } from '../lib/range-officer-review';

  // SPEC-004 §6: „Faktury” w menu admina z liczbą pozycji „Do wystawienia” (AC-10).
  void requireAdmin().then(async (supabase) => {
    const { count } = await supabase
      .from('orders')
      .select('id', { count: 'exact', head: true })
      .eq('invoice_requested', true)
      .is('invoice_number', null)
      .eq('status', 'paid');
    const badge = document.querySelector<HTMLElement>('[data-invoice-count]');
    if (!badge || !count) return;
    badge.textContent = ` (${count})`;
    badge.closest('a')?.setAttribute('aria-label', `${t('panel.menu.invoices')}, ${t('panel.menu.invoicesCount', { count })}`);
    badge.hidden = false;
  });

  // SPEC-007 AC-7: „Prowadzący (n)” — zgłoszenia z kont `pending` (Obsługa i admin; RLS `is_staff()`).
  function showOfficerCount(count: number): void {
    for (const badge of document.querySelectorAll<HTMLElement>('[data-officer-count]')) {
      const link = badge.closest('a');
      badge.textContent = count ? ` (${count})` : '';
      badge.hidden = !count;
      if (count) link?.setAttribute('aria-label', pendingMenuLabel(count));
      else link?.removeAttribute('aria-label');
    }
  }
  // Strona prowadzących podaje aktualną liczbę (także po decyzji) — ma pierwszeństwo przed zapytaniem niżej.
  let countFromPage = false;
  document.addEventListener(PENDING_COUNT_EVENT, (event) => {
    countFromPage = true;
    showOfficerCount(Number((event as CustomEvent).detail));
  });
  void requireStaff().then(async ({ supabase }) => {
    const { count } = await supabase
      .from('range_officers')
      .select('id', { count: 'exact', head: true })
      .eq('status', 'pending')
      .eq('is_active', true)
      .not('profile_id', 'is', null);
    if (count && !countFromPage) showOfficerCount(count);
  });
</script>
